#!/bin/sh
# Runs the MCP server of yart on the Node in yart.app, with the bundled daemon
# next to it. It finds its own link first, because the install puts a link to it
# in a different place.
set -e
here=$(dirname "$(readlink -f "$0")")
contents=$(cd "$here/../.." && pwd)
app="$contents/Resources/app.asar"
ELECTRON_RUN_AS_NODE=1 YART_DAEMON_CLI="$app/packages/daemon/dist/cli.mjs" \
  exec "$contents/MacOS/yart" "$app/packages/mcp/dist/cli.mjs" "$@"
