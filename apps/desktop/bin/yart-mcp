#!/bin/sh
# Runs yart's MCP server on the Node built into yart.app, pointing it at the
# daemon bundled beside it. Resolves its own link first: it is installed as a
# link elsewhere.
set -e
here=$(dirname "$(readlink -f "$0")")
contents=$(cd "$here/../.." && pwd)
app="$contents/Resources/app.asar"
ELECTRON_RUN_AS_NODE=1 YART_DAEMON_CLI="$app/packages/daemon/dist/cli.mjs" \
  exec "$contents/MacOS/yart" "$app/packages/mcp/dist/cli.mjs" "$@"
