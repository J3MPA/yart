{
  "name": "yart",
  "private": true,
  "version": "0.0.0",
  "description": "Local, GitHub-style code review for AI-generated diffs — inline comments loop back to your agent over MCP.",
  "license": "MIT",
  "author": "Jens Karlsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J3MPA/yart.git"
  },
  "packageManager": "pnpm@8.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @yart/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @yart/web preview",
    "typecheck": "pnpm -r typecheck"
  }
}
