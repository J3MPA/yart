{
  "name": "yart",
  "private": true,
  "version": "0.0.0",
  "description": "Local, GitHub-style code review for AI-generated diffs \u2014 inline comments loop back to your agent over MCP.",
  "license": "MIT",
  "author": "Jens Karlsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J3MPA/yart.git"
  },
  "packageManager": "pnpm@8.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @yart/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @yart/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "daemon": "pnpm --filter @yart/daemon start",
    "mcp": "pnpm --filter @yart/mcp start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}
